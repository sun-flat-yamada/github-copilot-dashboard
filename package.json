{
  "name": "github-copilot-dashboard",
  "version": "1.0.0",
  "description": "Enterprise-grade GitHub Copilot Usage and Billing Analytics Platform with 3-axis allocation and fork isolation",
  "private": true,
  "license": "MIT",
  "author": "sun-flat-yamada (Youhei Yamada)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sun-flat-yamada/github-copilot-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/sun-flat-yamada/github-copilot-dashboard/issues"
  },
  "homepage": "https://github.com/sun-flat-yamada/github-copilot-dashboard#readme",
  "keywords": [
    "github-copilot",
    "copilot-metrics",
    "finops",
    "billing",
    "cost-center",
    "github-pages",
    "dashboard",
    "analytics"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx scripts/update-benchmarks.ts",
    "pretest": "tsx scripts/update-benchmarks.ts",
    "build": "tsc && vite build && tsx scripts/check-bundle.ts",
    "bundle:check": "tsx scripts/check-bundle.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint dashboard/src",
    "pipeline:run": "tsx src/cli/run-pipeline.ts",
    "pipeline:mock": "tsx src/cli/run-pipeline.ts --mock",
    "pipeline:reprocess": "tsx src/cli/reprocess-pipeline.ts",
    "month:close": "tsx src/cli/month-close.ts close",
    "month:verify": "tsx src/cli/month-close.ts verify",
    "seat-audit:update": "tsx src/cli/seat-audit.ts update",
    "seat-audit:export": "tsx src/cli/seat-audit.ts export",
    "billing:report": "tsx src/cli/billing-reconcile.ts report",
    "billing:issues": "tsx src/cli/billing-reconcile.ts issues",
    "reports:validate": "tsx src/cli/reports.ts validate",
    "reports:generate": "tsx src/cli/reports.ts generate",
    "retention:plan": "tsx src/cli/retention.ts plan",
    "retention:apply": "tsx src/cli/retention.ts apply",
    "demo:generate": "tsx scripts/generate-demo-data.ts",
    "demo:sync": "tsx scripts/sync-demo-to-copilot-data.ts",
    "demo:setup": "tsx scripts/setup-fork-demo.ts",
    "demo:import": "tsx scripts/setup-fork-demo.ts",
    "report:import": "tsx scripts/import-report.ts",
    "mapping:encrypt": "tsx scripts/encrypt-user-mapping.ts",
    "mapping:decrypt": "tsx scripts/decrypt-user-mapping.ts",
    "schema:facts": "tsx scripts/generate-fact-schemas.ts",
    "catalog:fx": "tsx scripts/update-exchange-rates.ts",
    "benchmark:update": "tsx scripts/update-benchmarks.ts",
    "test": "tsx --test \"src/tests/**/*.test.ts\" \"src/tests/**/*.test.tsx\"",
    "secret-scan": "tsx scripts/scan-secrets.ts",
    "schema:drift": "tsx scripts/schema-drift.ts",
    "upstream:audit": "tsx scripts/audit-upstream-contribution.ts",
    "fork:verify": "tsx scripts/verify-fork-health.ts",
    "fork:status": "tsx scripts/verify-fork-health.ts --quick",
    "pages:stage": "tsx scripts/pages-staging.ts stage",
    "pages:verify": "tsx scripts/pages-staging.ts verify",
    "pages:status": "tsx scripts/check-pages-deployment.ts",
    "pages:wait": "tsx scripts/check-pages-deployment.ts --wait",
    "setup:hooks": "tsx scripts/setup-git-hooks.ts",
    "worktree:add": "tsx scripts/worktree-manage.ts add",
    "worktree:list": "tsx scripts/worktree-manage.ts list",
    "worktree:clean": "tsx scripts/worktree-manage.ts clean",
    "change-dev:plan-check": "tsx scripts/plan-first-check.ts",
    "change-dev:branch": "tsx scripts/change-dev-branch.ts",
    "change-dev:mode": "tsx scripts/change-dev-autopilot.ts mode",
    "change-dev:finish": "tsx scripts/change-dev-autopilot.ts finish",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
