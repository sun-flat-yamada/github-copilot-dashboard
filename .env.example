# =================================================================
# GitHub Copilot Analytics Platform - Environment Configuration
# =================================================================

# 1. GitHub API Authentication (Required for Live API fetching)
# GitHub PAT (Personal Access Token) with enterprise/org billing and copilot read permissions
COPILOT_READ_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Scope Targets (Specify either Enterprise or Organizations)
# Enterprise slug (if managing across the enterprise)
COPILOT_ENTERPRISE=your-enterprise-slug

# Comma-separated list of organization slugs (for single/multi-org setup)
COPILOT_ORGS=org-core,org-ai-labs,org-fintech

# 3. User Attribute Mapping (Stored in GitHub Variables / Secrets)
# Maps GitHub logins to Display Name, Department (仕訳グループ), and Cost Center override.
# Keep this in GitHub Actions Variables (VARS.COPILOT_USER_MAPPING) to avoid committing PII.
COPILOT_USER_MAPPING=[{"github_user":"taro-tanaka","display_name":"田中 太郎","department":"コア決済基盤チーム","cost_center_override":"FinTech-Division"},{"github_user":"hanako-suzuki","display_name":"鈴木 花子","department":"LLM応用プロダクトG","cost_center_override":"Research-and-AI"}]

# 4. Simulation & Testing
# Set to 'true' to generate realistic simulated Copilot data (2026.09 spec) without calling GitHub API
MOCK_MODE=false

# Anonymize usernames and departments on public dashboards
ANONYMIZE_USERS=false

# 5. Dashboard Hosting Base URL (for GitHub Pages repository path)
BASE_URL=./
