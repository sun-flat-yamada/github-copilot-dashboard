{
  "title": "fact.usage_user_feature_daily",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "user_key": {
      "type": "string",
      "minLength": 1
    },
    "feature": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "interactions": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "code_generations": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "code_acceptances": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "loc_suggested_add": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "loc_suggested_delete": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "loc_added": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "loc_deleted": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "api",
        "csv",
        "derived"
      ]
    },
    "quality": {
      "type": "string",
      "enum": [
        "measured",
        "estimated",
        "missing",
        "demo"
      ]
    }
  },
  "required": [
    "schema_version",
    "day",
    "user_key",
    "feature",
    "model",
    "interactions",
    "code_generations",
    "code_acceptances",
    "loc_suggested_add",
    "loc_suggested_delete",
    "loc_added",
    "loc_deleted",
    "source",
    "quality"
  ],
  "additionalProperties": false
}
