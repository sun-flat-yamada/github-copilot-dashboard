{
  "title": "fact.cost_line",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "user_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "quantity": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit_type": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "unit_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "gross": {
      "type": [
        "number",
        "null"
      ]
    },
    "discount": {
      "type": [
        "number",
        "null"
      ]
    },
    "net": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        {
          "type": "null"
        }
      ]
    },
    "pricing_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "api",
        "csv",
        "derived"
      ]
    },
    "quality": {
      "type": "string",
      "enum": [
        "measured",
        "estimated",
        "missing",
        "demo"
      ]
    }
  },
  "required": [
    "schema_version",
    "day",
    "user_key",
    "sku",
    "model",
    "quantity",
    "unit_type",
    "unit_price",
    "gross",
    "discount",
    "net",
    "currency",
    "pricing_version",
    "source",
    "quality"
  ],
  "additionalProperties": false
}
